# memory = local $0 demo (default). supabase when configured.
DATA_PROVIDER=memory

# mock | gemini | claude
VISION_PROVIDER=mock
VISION_MODEL=
READ_CONFIDENCE_THRESHOLD=0.8

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DAILY_GRADE_LIMIT=80
MAX_PAGES_PER_SUBMISSION=2

# Optional: HTTP grader. Empty = spawn local python CLI.
GRADER_URL=
