# memory = local $0 demo (default). supabase = local CLI or cloud project.
DATA_PROVIDER=memory

# mock | gemini | claude
VISION_PROVIDER=mock
VISION_MODEL=
READ_CONFIDENCE_THRESHOLD=0.8

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Required only when DATA_PROVIDER=supabase (see docs/local-supabase.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_TEACHER_ID=00000000-0000-4000-8000-000000000001

DAILY_GRADE_LIMIT=80
MAX_PAGES_PER_SUBMISSION=2

# Playwright / local demo reset (memory only)
ALLOW_E2E_RESET=

# Optional: HTTP grader. Empty = spawn local python CLI.
GRADER_URL=
